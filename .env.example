# Copy this file to .env and fill in your values.

# Required: your KnowledgeOwl API key.
# Create one at: Account > API > + Add new API key
# Give it Read on Article and Category for this knowledge base. Nothing else is needed.
KO_API_KEY=

# Required: the knowledge base (project) ID to export.
# Find it at: Articles page → the ID appears in the URL after /articles/id/
# Example: https://app.knowledgeowl.com/kb/articles/id/11abc2d3e45fg678h9012345
KO_PROJECT_ID=

# Optional: your knowledge base's public URL (used to build article links in frontmatter).
# Example: https://link.knowledgeowl.com
KO_KB_URL=

# Optional: where to write the exported Markdown files. Defaults to ./export
KO_OUTPUT_DIR=./export
